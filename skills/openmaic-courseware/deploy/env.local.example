# ============================================================
# OpenMAIC · 环境变量模板（openmaic-courseware 随包提供）
# ------------------------------------------------------------
# 用法：复制成 .env.local，放在 OpenMAIC 仓库根目录
#   cp env.local.example /path/to/OpenMAIC/.env.local
#
# **不要提交到版本库。** 确认上游 .gitignore 覆盖 .env*；没覆盖就自己补一行。
#
# 标注含义：
#   [必填]   缺了对应功能不可用（后果见行尾说明）
#   [按需]   按功能取舍，不开就别填
#   [编译期] 编译期变量，改动后必须重新构建镜像
#
# 本模板只保留变量名与占位说明，**不含任何真实 key**。
# 占位值形如 "<说明>"，使用前请替换成真实值。
# ============================================================

# ---------- 必填：模型与运行时 ----------
# [必填] 默认模型名。缺了服务端无法解析模型，生成请求直接失败。
DEFAULT_MODEL="<默认模型名，按你的 provider 填写>"
# [必填] 打开 agent runtime。缺了 /api/stages* 全部返回 404 纯文本。
OPENMAIC_AGENT_RUNTIME_ENABLED="1"
# [必填] 持久化数据库连接串。必须与上一项同时生效，/api/stages* 才不 404。
DATABASE_URL="<数据库连接串>"
# [必填] 模型路由映射。runtime 开启时必须显式路由 maic-agent-driver。
MODEL_ROUTES="<模型路由映射，需包含 maic-agent-driver>"

# ---------- 必填：持久化令牌（两处必须一致） ----------
# [必填] 服务端侧持久化令牌，任意随机串即可。
PERSISTENCE_DEV_TOKEN="<本地持久化令牌>"
# [必填][编译期] 前端侧持久化令牌，必须与上一项完全一致；改了要重新构建。
NEXT_PUBLIC_PERSISTENCE_TOKEN="<与 PERSISTENCE_DEV_TOKEN 完全一致的同一个值>"

# ---------- 必填：持久化能力声明 ----------
# [必填][编译期] 前端持久化能力声明开关。
NEXT_PUBLIC_PERSISTENCE="1"

# ---------- LLM provider：至少配一类（[按需]，配哪个填哪个） ----------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
QWEN_API_KEY=""
MINIMAX_API_KEY=""
GLM_API_KEY=""
KIMI_API_KEY=""
SILICONFLOW_API_KEY=""
DOUBAO_API_KEY=""
OPENROUTER_API_KEY=""
GROK_API_KEY=""
# 本地免 key 路线：填了 Ollama 地址就用本地模型，不需要上面任何 key。
# OLLAMA_BASE_URL="<本地 Ollama 服务地址>"

# ---------- 可选能力（[按需]） ----------
# 变量名以上游 .env.example 为准，不要凭空造名。
# 与请求体的对应关系见 ../references/api-contract.md：
#   搜索 -> webSearchProviderId / webSearchApiKey / webSearchModelId / baiduSubSources
#   图像 -> enableImageGeneration
#   视频 -> enableVideoGeneration
#   语音 -> enableTTS

# ---------- 访问与端口 ----------
# [按需] 全局访问码。设了就必须先 verify 换 openmaic_access cookie，否则受保护端点 401。
ACCESS_CODE=
# [必填] 纯 HTTP 本地部署必须是 0，否则浏览器拒收 Secure cookie，owner 分区漂移。
COOKIE_SECURE=0
# [按需] 宿主端口，容器内固定 3000。默认 3001，避开 3000 的常用占用。
OPENMAIC_HOST_PORT=3001
